{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1280px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "primary", "name": "Primary", "color": "#2563eb" },
				{ "slug": "secondary", "name": "Secondary", "color": "#0f172a" },
				{ "slug": "accent", "name": "Accent", "color": "#f97316" },
				{ "slug": "background", "name": "Background", "color": "#ffffff" },
				{ "slug": "surface", "name": "Surface", "color": "#f8fafc" },
				{ "slug": "foreground", "name": "Foreground", "color": "#111827" },
				{ "slug": "muted", "name": "Muted", "color": "#6b7280" },
				{ "slug": "border", "name": "Border", "color": "#e5e7eb" }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"]
		},
		"typography": {
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "sm", "size": "14px", "name": "Small" },
				{ "slug": "base", "size": "16px", "name": "Base" },
				{ "slug": "lg", "size": "18px", "name": "Large" },
				{ "slug": "xl", "size": "24px", "name": "XL" },
				{ "slug": "2xl", "size": "32px", "name": "2XL" },
				{ "slug": "3xl", "size": "48px", "name": "3XL" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|background",
			"text": "var:preset|color|foreground"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|base",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "24px"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "8px"
				},
				"color": {
					"background": "var:preset|color|primary",
					"text": "#ffffff"
				}
			},
			"link": {
				"color": {
					"text": "var:preset|color|primary"
				}
			}
		}
	}
}